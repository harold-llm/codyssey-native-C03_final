#!/bin/sh
# 카탈로그(콘텐츠) 데이터가 바뀌면 05-RAG-추천-자료.md를 자동으로 다시 만들어 같은 커밋에 넣는다.
# 설치(저장소마다 1회): git config core.hooksPath .githooks
if git diff --cached --name-only | grep -qE '^(backend/data/(catalog|content_guide|songs)\.json|backend/curriculum\.py|scripts/gen_catalog_doc\.py)$'; then
  python3 scripts/gen_catalog_doc.py >/dev/null || { echo "catalog 문서 생성 실패"; exit 1; }
  git add 05-RAG-추천-자료.md
fi
